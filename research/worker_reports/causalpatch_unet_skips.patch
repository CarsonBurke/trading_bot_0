+
+        // The four encoder outputs, straight-line.
+        let encoder_0 = Tensor::zeros([width], options) + tag(0);
+        let encoder_1 = &encoder_0 + tag(1);
+        let encoder_2 = &encoder_1 + tag(2);
+        let encoder_3 = &encoder_2 + tag(3);
